{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "encoding": {
    "x": {
      "field": "YearMonth",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": -45,
        "labelExpr": "indexof(['01','04','07','10'], slice(datum.value, 5)) >= 0 ? datum.value : ''"
      }
    }
  },
  "layer": [
    {
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#4e79a7",
            "opacity": 0.3
          },
          "encoding": {
            "y": {
              "field": "Total Sales",
              "type": "quantitative",
              "title": "Sales",
              "axis": {
                "titleColor": "#4e79a7",
                "format": "~s"
              }
            }
          }
        },
        {
          "mark": {
            "type": "bar",
            "color": "#4e79a7"
          },
          "encoding": {
            "y": {
              "field": "Total Sales__highlight",
              "type": "quantitative"
            },
            "opacity": {
              "condition": {
                "test": "datum.__selected__ == 'off'",
                "value": 0
              },
              "value": 1
            },
            "tooltip": [
              {
                "field": "YearMonth",
                "title": "Month"
              },
              {
                "field": "Total Sales",
                "format": ",.0f"
              },
              {
                "field": "Profit Ratio",
                "format": ".1%"
              }
            ]
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "color": "#f28e2b",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "color": "#f28e2b"
        }
      },
      "encoding": {
        "y": {
          "field": "Profit Ratio",
          "type": "quantitative",
          "title": "Profit ratio",
          "axis": {
            "format": ".0%",
            "titleColor": "#f28e2b",
            "grid": false
          }
        },
        "tooltip": [
          {
            "field": "YearMonth",
            "title": "Month"
          },
          {
            "field": "Profit Ratio",
            "format": ".1%"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}