{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "Region",
      "type": "nominal"
    },
    "y": {
      "field": "SubCategory",
      "type": "nominal"
    },
    "color": {
      "field": "Total Sales",
      "type": "quantitative",
      "scale": {
        "scheme": "blues"
      }
    }
  }
}