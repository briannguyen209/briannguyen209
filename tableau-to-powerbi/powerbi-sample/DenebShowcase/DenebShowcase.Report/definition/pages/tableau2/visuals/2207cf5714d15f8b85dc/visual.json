            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"description\": \"Scatter with trend line and average lines (quadrants)\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"point\",\n        \"filled\": true,\n        \"size\": 110\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Total Sales\",\n          \"type\": \"quantitative\",\n          \"title\": \"Sales\",\n          \"axis\": {\n            \"format\": \"~s\"\n          }\n        },\n        \"y\": {\n          \"field\": \"Total Profit\",\n          \"type\": \"quantitative\",\n          \"title\": \"Profit\",\n          \"axis\": {\n            \"format\": \"~s\"\n          }\n        },\n        \"color\": {\n          \"field\": \"Category\",\n          \"type\": \"nominal\"\n        },\n        \"shape\": {\n          \"field\": \"Region\",\n          \"type\": \"nominal\"\n        },\n        \"opacity\": {\n          \"condition\": [\n            {\n              \"test\": \"datum.__selected__ == ''off''\",\n              \"value\": 0.25\n            },\n            {\n              \"test\": \"datum[''Total Sales__highlightStatus''] == ''off''\",\n              \"value\": 0.25\n            }\n          ],\n          \"value\": 0.9\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"SubCategory\"\n          },\n          {\n            \"field\": \"Region\"\n          },\n          {\n            \"field\": \"Total Sales\",\n            \"format\": \",.0f\"\n          },\n          {\n            \"field\": \"Total Profit\",\n            \"format\": \",.0f\"\n          }\n        ]\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"line\",\n        \"color\": \"#777\",\n        \"strokeDash\": [\n          4,\n          3\n        ]\n      },\n      \"transform\": [\n        {\n          \"regression\": \"Total Profit\",\n          \"on\": \"Total Sales\"\n        }\n      ],\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Total Sales\",\n          \"type\": \"quantitative\"\n        },\n        \"y\": {\n          \"field\": \"Total Profit\",\n          \"type\": \"quantitative\"\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"rule\",\n        \"color\": \"#bbb\"\n      },\n      \"encoding\": {\n        \"x\": {\n          \"aggregate\": \"mean\",\n          \"field\": \"Total Sales\",\n          \"type\": \"quantitative\"\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"rule\",\n        \"color\": \"#bbb\"\n      },\n      \"encoding\": {\n        \"y\": {\n          \"aggregate\": \"mean\",\n          \"field\": \"Total Profit\",\n          \"type\": \"quantitative\"\n        }\n      }\n    }\n  ]\n}'"
                }
              }
            },
            "jsonConfig": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"autosize\": {\n    \"type\": \"fit\",\n    \"contains\": \"padding\"\n  },\n  \"view\": {\n    \"stroke\": null\n  },\n  \"font\": \"Segoe UI\",\n  \"axis\": {\n    \"labelColor\": \"#666\",\n    \"titleColor\": \"#333\",\n    \"gridColor\": \"#eee\",\n    \"domainColor\": \"#ccc\",\n    \"tickColor\": \"#ccc\",\n    \"labelFontSize\": 11,\n    \"titleFontSize\": 12,\n    \"titleFontWeight\": \"normal\"\n  },\n  \"legend\": {\n    \"labelColor\": \"#555\",\n    \"titleColor\": \"#333\"\n  },\n  \"range\": {\n    \"category\": [\n      \"#4e79a7\",\n      \"#f28e2b\",\n      \"#e15759\",\n      \"#76b7b2\",\n      \"#59a14f\",\n      \"#edc948\",\n      \"#b07aa1\",\n      \"#ff9da7\",\n      \"#9c755f\",\n      \"#bab0ac\"\n    ]\n  }\n}'"
