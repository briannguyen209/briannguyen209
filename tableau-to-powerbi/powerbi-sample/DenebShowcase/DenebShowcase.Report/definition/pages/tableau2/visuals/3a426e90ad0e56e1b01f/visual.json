            },
            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"description\": \"Bar-in-bar: target (wide, light) vs actual (narrow, coloured by status)\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"transform\": [\n    {\n      \"calculate\": \"datum[''Total Sales''] >= datum[''Total Target''] ? ''Met'' : ''Missed''\",\n      \"as\": \"Status\"\n    }\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"SubCategory\",\n      \"type\": \"nominal\",\n      \"sort\": \"-x\",\n      \"title\": null\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"color\": \"#c7d6e8\",\n        \"size\": 22\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Total Target\",\n          \"type\": \"quantitative\",\n          \"title\": \"Sales / Target\",\n          \"axis\": {\n            \"format\": \"~s\"\n          }\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"size\": 10\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Total Sales__highlight\",\n          \"type\": \"quantitative\"\n        },\n        \"color\": {\n          \"field\": \"Status\",\n          \"type\": \"nominal\",\n          \"title\": null,\n          \"scale\": {\n            \"domain\": [\n              \"Met\",\n              \"Missed\"\n            ],\n            \"range\": [\n              \"#4e79a7\",\n              \"#e15759\"\n            ]\n          }\n        },\n        \"opacity\": {\n          \"condition\": {\n            \"test\": \"datum.__selected__ == ''off''\",\n            \"value\": 0.25\n          },\n          \"value\": 1\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"SubCategory\"\n          },\n          {\n            \"field\": \"Total Sales\",\n            \"format\": \",.0f\"\n          },\n          {\n            \"field\": \"Total Target\",\n            \"format\": \",.0f\"\n          },\n          {\n            \"field\": \"Attainment %\",\n            \"format\": \".1%\"\n          }\n        ]\n      }\n    }\n  ]\n}'"
                }
              }
            },
            "jsonConfig": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"autosize\": {\n    \"type\": \"fit\",\n    \"contains\": \"padding\"\n  },\n  \"view\": {\n    \"stroke\": null\n  },\n  \"font\": \"Segoe UI\",\n  \"axis\": {\n    \"labelColor\": \"#666\",\n    \"titleColor\": \"#333\",\n    \"gridColor\": \"#eee\",\n    \"domainColor\": \"#ccc\",\n    \"tickColor\": \"#ccc\",\n    \"labelFontSize\": 11,\n    \"titleFontSize\": 12,\n    \"titleFontWeight\": \"normal\"\n  },\n  \"legend\": {\n    \"labelColor\": \"#555\",\n    \"titleColor\": \"#333\"\n  },\n  \"range\": {\n    \"category\": [\n      \"#4e79a7\",\n      \"#f28e2b\",\n      \"#e15759\",\n      \"#76b7b2\",\n      \"#59a14f\",\n      \"#edc948\",\n      \"#b07aa1\",\n      \"#ff9da7\",\n      \"#9c755f\",\n      \"#bab0ac\"\n    ]\n  }\n}'"
