{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tableau 'Highlight Table': bảng màu + số theo Region x SubCategory",
  "data": {
    "name": "dataset"
  },
  "width": 420,
  "height": 300,
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Sales",
          "as": "Sales"
        }
      ],
      "groupby": [
        "Region",
        "SubCategory"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "Region",
      "type": "nominal",
      "axis": {
        "orient": "top",
        "title": null,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "SubCategory",
      "type": "nominal",
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "Sales",
          "type": "quantitative",
          "scale": {
            "scheme": "blues"
          },
          "title": "Doanh số"
        },
        "tooltip": [
          {
            "field": "Region"
          },
          {
            "field": "SubCategory"
          },
          {
            "field": "Sales",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "Sales",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "condition": {
            "test": "datum.Sales > 150000",
            "value": "white"
          },
          "value": "#333"
        }
      }
    }
  ],
  "config": {
    "font": "Segoe UI",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#666",
      "titleColor": "#333",
      "gridColor": "#eee",
      "domainColor": "#ccc",
      "tickColor": "#ccc",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelColor": "#555",
      "titleColor": "#333",
      "orient": "right"
    },
    "range": {
      "category": {
        "scheme": "tableau10"
      },
      "heatmap": {
        "scheme": "blues"
      },
      "diverging": {
        "scheme": "redblue"
      }
    },
    "header": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}