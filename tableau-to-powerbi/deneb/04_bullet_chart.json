{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tableau 'Bullet Graph': dải tham chiếu 60/80/100% mục tiêu, thanh thực tế, vạch mục tiêu",
  "data": {
    "name": "dataset"
  },
  "width": 520,
  "height": 180,
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Sales",
          "as": "Sales"
        },
        {
          "op": "sum",
          "field": "Target",
          "as": "Target"
        }
      ],
      "groupby": [
        "Category"
      ]
    },
    {
      "calculate": "datum.Target*0.6",
      "as": "B60"
    },
    {
      "calculate": "datum.Target*0.8",
      "as": "B80"
    },
    {
      "calculate": "datum.Target*1.2",
      "as": "B120"
    }
  ],
  "encoding": {
    "y": {
      "field": "Category",
      "type": "nominal",
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#e6e6e6",
        "size": 30
      },
      "encoding": {
        "x": {
          "field": "B120",
          "type": "quantitative",
          "title": "Doanh số"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#cfcfcf",
        "size": 30
      },
      "encoding": {
        "x": {
          "field": "Target",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#b5b5b5",
        "size": 30
      },
      "encoding": {
        "x": {
          "field": "B80",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#9e9e9e",
        "size": 30
      },
      "encoding": {
        "x": {
          "field": "B60",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#4e79a7",
        "size": 12
      },
      "encoding": {
        "x": {
          "field": "Sales",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Sales",
            "format": ",.0f"
          },
          {
            "field": "Target",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "tick",
        "color": "black",
        "thickness": 3,
        "size": 28
      },
      "encoding": {
        "x": {
          "field": "Target",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "font": "Segoe UI",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#666",
      "titleColor": "#333",
      "gridColor": "#eee",
      "domainColor": "#ccc",
      "tickColor": "#ccc",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelColor": "#555",
      "titleColor": "#333",
      "orient": "right"
    },
    "range": {
      "category": {
        "scheme": "tableau10"
      },
      "heatmap": {
        "scheme": "blues"
      },
      "diverging": {
        "scheme": "redblue"
      }
    },
    "header": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}