# Lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Chat ID của bạn (nhắn @userinfobot để biết)
TELEGRAM_CHAT_ID=123456789

# Thư mục Claude sẽ làm việc
CLAUDE_WORKDIR=/home/claude/projects
# Đường dẫn lệnh claude (chạy `which claude` để biết)
CLAUDE_BIN=claude
# acceptEdits: Claude được sửa file nhưng lệnh shell nguy hiểm vẫn bị chặn.
# Muốn Claude chạy mọi lệnh không hỏi: --dangerously-skip-permissions (chỉ dùng trên VPS riêng)
CLAUDE_EXTRA_ARGS=--permission-mode acceptEdits
CLAUDE_TIMEOUT=1800
